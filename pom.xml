<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>tcs</groupId>
    <artifactId>jenkins</artifactId>
    <version>1.5-SNAPSHOT</version>

    <name>jenkins</name>

    <!-- Git repository used by Maven Release Plugin -->
    <scm>
        <connection>
            scm:git:git@github.com:anilkumarreddy10/test_repo.git
        </connection>

        <developerConnection>
            scm:git:git@github.com:anilkumarreddy10/test_repo.git
        </developerConnection>

        <tag>HEAD</tag>
    </scm>


    <!-- Nexus repositories -->
    <distributionManagement>

        <repository>
            <id>maven-releases</id>
            <name>Internal Maven Release Repository</name>
            <url>${releases.distribution.url}</url>
        </repository>

        <snapshotRepository>
            <id>maven-snapshots</id>
            <name>Internal Maven Snapshots Repository</name>
            <url>${snapshots.distribution.url}</url>
        </snapshotRepository>

    </distributionManagement>


    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <repository.server.root>
            http://35.253.88.8:8081/repository
        </repository.server.root>

        <releases.distribution.url>
            ${repository.server.root}/maven-releases/
        </releases.distribution.url>

        <snapshots.distribution.url>
            ${repository.server.root}/maven-snapshots/
        </snapshots.distribution.url>

    </properties>


    <dependencies>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <build>

        <plugins>

            <!--
                Creates an executable JAR.

                Your Java class is:
                package tcs;
                public class App

                Therefore Main-Class must be tcs.App
            -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>

                <configuration>

                    <archive>

                        <manifest>

                            <addClasspath>true</addClasspath>

                            <mainClass>tcs.App</mainClass>

                        </manifest>

                    </archive>

                </configuration>

            </plugin>


            <!-- Maven compiler -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <version>3.8.1</version>

                <configuration>

                    <source>1.8</source>
                    <target>1.8</target>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>
