<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>tcs</groupId>
    <artifactId>jenkins</artifactId>
    <version>1.5-SNAPSHOT</version>

    <name>jenkins</name>

    <!-- ============================== -->
    <!-- Java configuration -->
    <!-- ============================== -->

    <properties>
        <java.version>17</java.version>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <!-- Nexus -->
        <repository.server.root>
            http://35.253.88.8:8081/repository
        </repository.server.root>

        <releases.distribution.url>
            ${repository.server.root}/maven-releases/
        </releases.distribution.url>

        <snapshots.distribution.url>
            ${repository.server.root}/maven-snapshots/
        </snapshots.distribution.url>

    </properties>


    <!-- ============================== -->
    <!-- Git -->
    <!-- ============================== -->

    <scm>

        <connection>
            scm:git:git@github.com:anilkumarreddy10/test_repo.git
        </connection>

        <developerConnection>
            scm:git:git@github.com:anilkumarreddy10/test_repo.git
        </developerConnection>

        <tag>HEAD</tag>

    </scm>


    <!-- ============================== -->
    <!-- Nexus -->
    <!-- ============================== -->

    <distributionManagement>

        <repository>
            <id>maven-releases</id>
            <name>Internal Maven Release Repository</name>
            <url>${releases.distribution.url}</url>
        </repository>

        <snapshotRepository>
            <id>maven-snapshots</id>
            <name>Internal Maven Snapshot Repository</name>
            <url>${snapshots.distribution.url}</url>
        </snapshotRepository>

    </distributionManagement>


    <!-- ============================== -->
    <!-- Dependencies -->
    <!-- ============================== -->

    <dependencies>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ============================== -->
    <!-- Build -->
    <!-- ============================== -->

    <build>

        <plugins>

            <!-- Explicit Java 17 compiler -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <release>17</release>
                </configuration>

            </plugin>


            <!-- Create executable Spring Boot JAR -->
            <plugin>

                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <mainClass>tcs.App</mainClass>
                </configuration>

            </plugin>

        </plugins>

    </build>

</project>
